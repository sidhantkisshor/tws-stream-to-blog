{
  "name": "TWS Stream Detection",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/videos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "part", "value": "snippet,liveStreamingDetails" },
            { "name": "id", "value": "={{ $json.videoId || $vars.LIVE_VIDEO_ID }}" }
          ]
        },
        "options": {}
      },
      "id": "youtube-check",
      "name": "Check YouTube Video Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpQueryAuth": {
          "id": "YOUTUBE_API_CREDENTIAL_ID",
          "name": "YouTube API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "stream-ended",
              "leftValue": "={{ $json.items[0].snippet.liveBroadcastContent }}",
              "rightValue": "none",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-stream-ended",
      "name": "Stream Ended?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT video_id FROM pipeline_runs WHERE video_id = '{{ $json.items[0].id }}'",
        "options": {}
      },
      "id": "check-state-store",
      "name": "Check If Already Processed",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [900, 200],
      "notes": "Connect to your SQLite database file at /path/to/tws-pipeline.db"
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "not-processed",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-not-processed",
      "name": "Not Yet Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pipeline_runs (video_id, channel_id, detected_at, status, updated_at) VALUES ('{{ $node[\"Check YouTube Video Status\"].json.items[0].id }}', '{{ $node[\"Check YouTube Video Status\"].json.items[0].snippet.channelId }}', datetime('now'), 'pending', datetime('now'))"
      },
      "id": "insert-state",
      "name": "Record in State Store",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "minutes"
      },
      "id": "wait-15min",
      "name": "Wait 15 Min (VOD Processing)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.PROCESS_WEBHOOK_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "video_id",
              "value": "={{ $node[\"Check YouTube Video Status\"].json.items[0].id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "trigger-processing",
      "name": "Trigger Processing Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 200]
    }
  ],
  "connections": {
    "Every 5 Minutes": { "main": [[{ "node": "Check YouTube Video Status", "type": "main", "index": 0 }]] },
    "Check YouTube Video Status": { "main": [[{ "node": "Stream Ended?", "type": "main", "index": 0 }]] },
    "Stream Ended?": { "main": [[{ "node": "Check If Already Processed", "type": "main", "index": 0 }], []] },
    "Check If Already Processed": { "main": [[{ "node": "Not Yet Processed?", "type": "main", "index": 0 }]] },
    "Not Yet Processed?": { "main": [[{ "node": "Record in State Store", "type": "main", "index": 0 }], []] },
    "Record in State Store": { "main": [[{ "node": "Wait 15 Min (VOD Processing)", "type": "main", "index": 0 }]] },
    "Wait 15 Min (VOD Processing)": { "main": [[{ "node": "Trigger Processing Workflow", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [{ "name": "TWS" }]
}
