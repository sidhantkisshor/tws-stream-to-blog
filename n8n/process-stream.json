{
  "name": "TWS Process Stream",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-stream",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "process-stream"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.LOCAL_API_URL }}/health",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "health-check",
      "name": "Health Check Local Machine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LOCAL_API_KEY_CREDENTIAL_ID",
          "name": "Local API Key"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "local-online",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-local-online",
      "name": "Local Machine Online?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300],
      "notes": "Checks health endpoint returned status: ok (not just any response)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LOCAL_API_URL }}/transcribe",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "video_id", "value": "={{ $node['Webhook Trigger'].json.body.video_id }}" }
          ]
        },
        "options": {}
      },
      "id": "local-transcribe",
      "name": "Local: Start Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LOCAL_API_KEY_CREDENTIAL_ID",
          "name": "Local API Key"
        }
      }
    },
    {
      "parameters": { "amount": 30, "unit": "seconds" },
      "id": "wait-transcribe",
      "name": "Wait 30s (Transcription)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1140, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.LOCAL_API_URL }}/status/{{ $node['Local: Start Transcription'].json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "poll-transcribe",
      "name": "Poll Transcription Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LOCAL_API_KEY_CREDENTIAL_ID",
          "name": "Local API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "job-complete",
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-transcribe-done",
      "name": "Transcription Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1580, 180]
    },
    {
      "parameters": {
        "jsCode": "// Store transcript from poll result for later use\nconst transcriptData = $node['Poll Transcription Status'].json;\nreturn [{ json: { transcript: transcriptData.result.full_text, video_id: $node['Webhook Trigger'].json.body.video_id } }];"
      },
      "id": "store-transcript",
      "name": "Store Transcript Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LOCAL_API_URL }}/extract-charts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "video_id", "value": "={{ $json.video_id }}" }
          ]
        },
        "options": {}
      },
      "id": "local-extract-charts",
      "name": "Local: Start Chart Extraction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LOCAL_API_KEY_CREDENTIAL_ID",
          "name": "Local API Key"
        }
      }
    },
    {
      "parameters": { "amount": 30, "unit": "seconds" },
      "id": "wait-charts",
      "name": "Wait 30s (Charts)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2240, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.LOCAL_API_URL }}/status/{{ $node['Local: Start Chart Extraction'].json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "poll-charts",
      "name": "Poll Chart Extraction Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2460, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "LOCAL_API_KEY_CREDENTIAL_ID",
          "name": "Local API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "charts-complete",
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-charts-done",
      "name": "Charts Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2680, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LLM_PIPELINE_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_id\": {{ JSON.stringify($node['Store Transcript Data'].json.video_id) }},\n  \"transcript\": {{ JSON.stringify($node['Store Transcript Data'].json.transcript) }},\n  \"chart_urls\": {{ JSON.stringify($node['Poll Chart Extraction Status'].json.result ? $node['Poll Chart Extraction Status'].json.result.charts : []) }}\n}",
        "options": {}
      },
      "id": "trigger-llm-local",
      "name": "Trigger LLM Pipeline (Local Path)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2900, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "whisper-1" },
            { "name": "response_format", "value": "verbose_json" }
          ]
        },
        "options": {}
      },
      "id": "cloud-transcribe",
      "name": "Cloud: OpenAI Whisper API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 440],
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENAI_API_KEY_CREDENTIAL_ID",
          "name": "OpenAI API Key"
        }
      },
      "notes": "Cloud fallback: Download audio with a Code node (yt-dlp) before this step, then attach as file upload. The audio file parameter needs to be configured for your setup."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.LLM_PIPELINE_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_id\": {{ JSON.stringify($node['Webhook Trigger'].json.body.video_id) }},\n  \"transcript\": {{ JSON.stringify($json.text || '') }},\n  \"chart_urls\": []\n}",
        "options": {}
      },
      "id": "trigger-llm-cloud",
      "name": "Trigger LLM Pipeline (Cloud Path)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 440],
      "notes": "Cloud path sends empty chart_urls since chart extraction is not available in cloud fallback. Chart URLs would need a cloud function to be added here."
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Health Check Local Machine", "type": "main", "index": 0 }]] },
    "Health Check Local Machine": { "main": [[{ "node": "Local Machine Online?", "type": "main", "index": 0 }]] },
    "Local Machine Online?": {
      "main": [
        [{ "node": "Local: Start Transcription", "type": "main", "index": 0 }],
        [{ "node": "Cloud: OpenAI Whisper API", "type": "main", "index": 0 }]
      ]
    },
    "Local: Start Transcription": { "main": [[{ "node": "Wait 30s (Transcription)", "type": "main", "index": 0 }]] },
    "Wait 30s (Transcription)": { "main": [[{ "node": "Poll Transcription Status", "type": "main", "index": 0 }]] },
    "Poll Transcription Status": { "main": [[{ "node": "Transcription Done?", "type": "main", "index": 0 }]] },
    "Transcription Done?": {
      "main": [
        [{ "node": "Store Transcript Data", "type": "main", "index": 0 }],
        [{ "node": "Wait 30s (Transcription)", "type": "main", "index": 0 }]
      ]
    },
    "Store Transcript Data": { "main": [[{ "node": "Local: Start Chart Extraction", "type": "main", "index": 0 }]] },
    "Local: Start Chart Extraction": { "main": [[{ "node": "Wait 30s (Charts)", "type": "main", "index": 0 }]] },
    "Wait 30s (Charts)": { "main": [[{ "node": "Poll Chart Extraction Status", "type": "main", "index": 0 }]] },
    "Poll Chart Extraction Status": { "main": [[{ "node": "Charts Done?", "type": "main", "index": 0 }]] },
    "Charts Done?": {
      "main": [
        [{ "node": "Trigger LLM Pipeline (Local Path)", "type": "main", "index": 0 }],
        [{ "node": "Wait 30s (Charts)", "type": "main", "index": 0 }]
      ]
    },
    "Cloud: OpenAI Whisper API": { "main": [[{ "node": "Trigger LLM Pipeline (Cloud Path)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "TWS" }]
}
