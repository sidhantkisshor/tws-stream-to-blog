      "parameters": {
        "jsCode": "const MAX_RETRIES = 40;\nconst status = $json.status;\nconst retryCount = ($json._retryCount || 0) + 1;\n\nif (status === 'complete') {\n  return [{ json: { ...($json), _result: 'complete' } }];\n}\n\nif (status === 'failed' || status === 'error') {\n  return [{ json: { ...($json), _result: 'failed', _error: $json.error || 'Job reported failure' } }];\n}\n\nif (retryCount >= MAX_RETRIES) {\n  return [{ json: { ...($json), _result: 'failed', _error: 'Chart extraction polling timed out after ' + MAX_RETRIES + ' attempts' } }];\n}\n\nreturn [{ json: { ...($json), _result: 'pending', _retryCount: retryCount } }];"
