    {
      "parameters": {
        "jsCode": "// Download audio from YouTube using yt-dlp\n// Requires yt-dlp installed on the n8n server: pip install yt-dlp\nconst { execSync } = require('child_process');\nconst fs = require('fs');\nconst path = require('path');\n\nconst videoId = $node['Webhook Trigger'].json.body.video_id;\nconst sanitizedId = videoId.replace(/[^A-Za-z0-9_-]/g, '');\nconst outputDir = '/tmp/tws-audio';\nconst outputPath = path.join(outputDir, `${sanitizedId}.mp3`);\n\nif (!fs.existsSync(outputDir)) {\n  fs.mkdirSync(outputDir, { recursive: true });\n}\n\ntry {\n  execSync(\n    `yt-dlp -x --audio-format mp3 --audio-quality 5 -o \"${outputPath}\" \"https://www.youtube.com/watch?v=${sanitizedId}\"`,\n    { timeout: 600000, maxBuffer: 50 * 1024 * 1024 }\n  );\n\n  const audioBuffer = fs.readFileSync(outputPath);\n  fs.unlinkSync(outputPath);\n\n  // Output as n8n binary data so the native OpenAI transcribe node can read it directly\n  return [{\n    json: { video_id: sanitizedId },\n    binary: {\n      data: {\n        data: audioBuffer.toString('base64'),\n        mimeType: 'audio/mpeg',\n        fileName: `${sanitizedId}.mp3`\n      }\n    }\n  }];\n} catch (error) {\n  try { fs.unlinkSync(outputPath); } catch (e) {}\n  throw new Error(`yt-dlp audio download failed: ${error.message}`);\n}"
      },
      "id": "b2c3d4e5-0021-0021-0021-000000000021",
      "name": "Cloud: Download Audio (yt-dlp)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        480
      ],
      "notes": "Requires yt-dlp installed on the n8n server. Outputs n8n binary data (not base64 JSON) so the native OpenAI transcribe node can attach it as a file directly."
    },
