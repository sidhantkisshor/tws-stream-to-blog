{
  "name": "TWS Publish Blog",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-blog",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "d4e5f6a7-0001-0001-0001-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "publish-blog",
      "credentials": {
        "httpHeaderAuth": {
          "id": "IlRAwjG9guzimnOg",
          "name": "N8N Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "blog-url",
              "name": "BLOG_URL",
              "value": "={{ $env.BLOG_BASE_URL }}",
              "type": "string"
            },
            {
              "id": "tg-chat-id",
              "name": "TG_CHAT_ID",
              "value": "1003723441488",
              "type": "string"
            }
          ]
        }
      },
      "id": "d4e5f6a7-0002-0002-0002-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.BLOG_URL }}/api/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($node['Webhook Trigger'].json.body) }}",
        "options": {}
      },
      "id": "d4e5f6a7-0003-0003-0003-000000000003",
      "name": "Publish to Blog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "0tQCFipJNNOb5vyJ",
          "name": "Blog Publish API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $node['Config'].json.BLOG_URL }}/posts/{{ $json.slug }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000004",
      "name": "Validate Published URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "is-200",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        }
      },
      "id": "d4e5f6a7-0005-0005-0005-000000000005",
      "name": "Published Successfully?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pipeline_runs SET status = 'complete', blog_post_id = $1, published_url = $2, updated_at = NOW() WHERE video_id = $3",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify([ String($node['Publish to Blog'].json.id || ''), ($node['Config'].json.BLOG_URL + '/posts/' + String($node['Publish to Blog'].json.slug || '')), String($node['Webhook Trigger'].json.body.videoId || '') ]) }}"
        }
      },
      "id": "d4e5f6a7-0006-0006-0006-000000000006",
      "name": "Update State: Complete",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1240, 180],
      "credentials": {
        "postgres": {
          "id": "6bcm49YU2mxAoGUG",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pipeline_runs SET status = 'failed', error_message = $1, failed_step = 'validate', updated_at = NOW() WHERE video_id = $2",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify([ 'Publish validation failed - page did not return 200', String($node['Webhook Trigger'].json.body.videoId || '') ]) }}"
        }
      },
      "id": "d4e5f6a7-0007-0007-0007-000000000007",
      "name": "Update State: Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1240, 420],
      "credentials": {
        "postgres": {
          "id": "6bcm49YU2mxAoGUG",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $node['Config'].json.TG_CHAT_ID }}",
        "text": "=✅ *New TWS Blog Post Published*\nTitle: {{ $node['Publish to Blog'].json.title || 'N/A' }}\nURL: {{ $node['Config'].json.BLOG_URL }}/posts/{{ $node['Publish to Blog'].json.slug }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
      "id": "d4e5f6a7-0008-0008-0008-000000000008",
      "name": "Notify: TG Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1480, 180],
      "credentials": {
        "telegramApi": {
          "id": "0V7hd11iSvVFEPaD",
          "name": "TWSN8N_Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $node['Config'].json.TG_CHAT_ID }}",
        "text": "=❌ *TWS Blog Pipeline Failed*\nVideo: {{ $node['Webhook Trigger'].json.body.videoId }}\nStep: Publish Validation\nError: Page did not return 200",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
      "id": "d4e5f6a7-0009-0009-0009-000000000009",
      "name": "Notify: TG Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1480, 420],
      "credentials": {
        "telegramApi": {
          "id": "0V7hd11iSvVFEPaD",
          "name": "TWSN8N_Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Publish to Blog", "type": "main", "index": 0 }]]
    },
    "Publish to Blog": {
      "main": [[{ "node": "Validate Published URL", "type": "main", "index": 0 }]]
    },
    "Validate Published URL": {
      "main": [[{ "node": "Published Successfully?", "type": "main", "index": 0 }]]
    },
    "Published Successfully?": {
      "main": [
        [{ "node": "Update State: Complete", "type": "main", "index": 0 }],
        [{ "node": "Update State: Failed", "type": "main", "index": 0 }]
      ]
    },
    "Update State: Complete": {
      "main": [[{ "node": "Notify: TG Success", "type": "main", "index": 0 }]]
    },
    "Update State: Failed": {
      "main": [[{ "node": "Notify: TG Alert", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
