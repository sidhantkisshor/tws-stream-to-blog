{
  "name": "TWS Publish Blog",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publish-blog",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "publish-blog"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.BLOG_URL }}/api/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "publish-post",
      "name": "Publish to Blog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "BLOG_PUBLISH_KEY_CREDENTIAL_ID",
          "name": "Blog Publish API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.BLOG_URL }}/posts/{{ $json.slug }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "validate-published",
      "name": "Validate Published URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "is-200",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if-valid",
      "name": "Published Successfully?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE pipeline_runs SET status='complete', blog_post_id='{{ $node['Publish to Blog'].json.id }}', published_url='{{ $vars.BLOG_URL }}/posts/{{ $node['Publish to Blog'].json.slug }}', updated_at=datetime('now') WHERE video_id='{{ $node['Webhook Trigger'].json.body.videoId }}'"
      },
      "id": "update-state-complete",
      "name": "Update State: Complete",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE pipeline_runs SET status='failed', error_message='Publish validation failed - page did not return 200', failed_step='validate', updated_at=datetime('now') WHERE video_id='{{ $node['Webhook Trigger'].json.body.videoId }}'"
      },
      "id": "update-state-failed",
      "name": "Update State: Failed",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [1200, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"❌ **TWS Blog Pipeline Failed**\\nVideo: {{ $node['Webhook Trigger'].json.body.videoId }}\\nStep: Publish Validation\\nError: Page did not return 200\"\n}",
        "options": {}
      },
      "id": "notify-failure",
      "name": "Notify: Discord Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"✅ **New TWS Blog Post Published**\\nTitle: {{ $node['Publish to Blog'].json.title || 'N/A' }}\\nURL: {{ $vars.BLOG_URL }}/posts/{{ $node['Publish to Blog'].json.slug }}\"\n}",
        "options": {}
      },
      "id": "notify-success",
      "name": "Notify: Discord Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 200]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Publish to Blog", "type": "main", "index": 0 }]] },
    "Publish to Blog": { "main": [[{ "node": "Validate Published URL", "type": "main", "index": 0 }]] },
    "Validate Published URL": { "main": [[{ "node": "Published Successfully?", "type": "main", "index": 0 }]] },
    "Published Successfully?": {
      "main": [
        [{ "node": "Update State: Complete", "type": "main", "index": 0 }],
        [{ "node": "Update State: Failed", "type": "main", "index": 0 }]
      ]
    },
    "Update State: Complete": { "main": [[{ "node": "Notify: Discord Success", "type": "main", "index": 0 }]] },
    "Update State: Failed": { "main": [[{ "node": "Notify: Discord Alert", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "TWS" }]
}
